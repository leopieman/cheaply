# Supabase / Postgres connection string (required)
# Use the Session Pooler URL from Supabase → Project Settings → Database (IPv4-compatible, works on Railway)
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Supabase project URL for health checks (e.g. https://xxxx.supabase.co)
SUPABASE_URL=https://xxxx.supabase.co

# Resend API key (required)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Verified sender — use onboarding@resend.dev until cheaply.ie domain is verified
FROM_EMAIL=cheaply.ie <onboarding@resend.dev>

# CORS: set to the frontend URL in production (e.g. https://cheaply.ie)
CORS_ORIGIN=*

# Port (Railway sets this automatically)
PORT=3000
